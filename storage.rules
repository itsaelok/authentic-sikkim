rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Uploaded news images: public to view, only an admin can upload
    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: everything else requires an authenticated admin
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
